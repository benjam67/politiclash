// Serveur de France Bagarre sur Cloudflare Workers (phase 7c).
// Déployé par GitHub Actions (.github/workflows/server.yml) ; les clés du relais sont des secrets
// (TURN_KEY_ID, TURN_KEY_API_TOKEN), jamais dans le dépôt.
{
  "name": "france-bagarre",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // File d'attente de la Partie rapide : un Durable Object (stockage SQLite, seul disponible en offre gratuite).
  // Classement : un second Durable Object, avec sa base SQLite.
  "durable_objects": {
    "bindings": [
      { "name": "QUEUE", "class_name": "QueueDO" },
      { "name": "RANK", "class_name": "RankDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QueueDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RankDO"] }
  ],
  "vars": {
    // Pages autorisées à demander des accès au relais (le jeu publié sur son domaine et sur workers.dev, l'ancienne adresse GitHub Pages, et les essais en local).
    "ALLOWED_ORIGINS": "https://france-bagarre.fr,https://www.france-bagarre.fr,https://france-bagarre-site.ben-aub.workers.dev,https://benjam67.github.io,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173"
  }
}
