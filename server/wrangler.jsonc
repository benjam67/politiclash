// Serveur de France Bagarre sur Cloudflare Workers (phase 7c).
// Déployé par GitHub Actions (.github/workflows/server.yml) ; les clés du relais sont des secrets
// (TURN_KEY_ID, TURN_KEY_API_TOKEN), jamais dans le dépôt.
{
  "name": "france-bagarre",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // Pages autorisées à demander des accès au relais (le jeu publié, et les essais en local).
    "ALLOWED_ORIGINS": "https://benjam67.github.io,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173"
  }
}
